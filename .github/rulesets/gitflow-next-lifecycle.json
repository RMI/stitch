{
  "name": "gitflow-next-lifecycle",
  "target": "branch",
  "source_type": "Repository",
  "source": "RMI/stitch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["refs/heads/next", "refs/heads/hotfix/**"]
    }
  },
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "deletion"
    }
  ]
}
