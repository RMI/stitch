{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "k6 \u2014 PR response-time comparison",
  "uid": "k6-pr-compare",
  "tags": [
    "k6",
    "loadtest"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test runs (testid)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "stitch-prom"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total, testid)",
          "refId": "testid"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "avg / p95 / p99 by endpoint, across runs (lower is better)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "list \u2014 avg / p95 / p99 (s)",
      "description": "GET /oil-gas-fields/ list+search. Grouped bars (avg, p95, p99) per run; a wide p99-vs-p95 gap means a long tail.",
      "datasource": {
        "type": "prometheus",
        "uid": "stitch-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xField": "testid",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "avg by (testid) (last_over_time(k6_http_req_duration_avg{name=\"list\", testid=~\"$testid\"}[$__range]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "avg by (testid) (last_over_time(k6_http_req_duration_p95{name=\"list\", testid=~\"$testid\"}[$__range]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "avg by (testid) (last_over_time(k6_http_req_duration_p99{name=\"list\", testid=~\"$testid\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "testid",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "avg",
              "Value #B": "p95",
              "Value #C": "p99"
            }
          }
        }
      ]
    },
    {
