    {
      "type": "row",
      "title": "Per-endpoint latency stats \u2014 all endpoints, all runs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Latency stats by endpoint and run (count in requests, rest in s)",
      "datasource": {
        "type": "prometheus",
        "uid": "stitch-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(sum by (testid, name) (last_over_time(k6_http_reqs_total{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"count\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_avg{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"avg\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_med{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"med\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_p90{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"p90\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_p95{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"p95\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_p99{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"p99\", \"name\", \".*\")",
          "instant": true
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "label_replace(max by (testid, name) (last_over_time(k6_http_req_duration_max{name=~\"by-id|detail|filter-options|list\", testid=~\"$testid\"}[$__range])), \"stat\", \"max\", \"name\", \".*\")",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByLabels",
          "options": {
            "value": "stat",
            "join": [
              "testid",
              "name"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "name": "endpoint"
            },
            "indexByName": {
              "endpoint": 0,
              "name": 0,
              "testid": 1,
              "count": 2,
              "avg": 3,
              "med": 4,
              "p90": 5,
              "p95": 6,
              "p99": 7,
              "max": 8
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "endpoint",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput & errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
