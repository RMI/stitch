      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "stitch-prom"
          },
          "expr": "topk(1, last_over_time(k6_http_req_duration_p95{testid=~\"$testid\", name!=\"setup\"}[$__range])) by (testid)",
          "legendFormat": "{{testid}} \u00b7 {{name}}",
